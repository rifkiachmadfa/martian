index 00000000..a4d6783b
--- /dev/null
+++ b/Assets/Script/Suit/SuitStation.cs
@@ -0,0 +1,81 @@
+using UnityEngine;
+
+/// <summary>
+/// Suit Station di Control Room. Interaksi: mengenakan suit (jika belum) dan mengisi tabung oksigen suit
+/// dari stok oksigen habitat. Pasang pada objek ber-layer Interactable dengan Collider2D (Is Trigger).
+/// </summary>
+public class SuitStation : MonoBehaviour, IInteractable
+{
+    [Header("Referensi (otomatis dicari jika kosong)")]
+    [SerializeField] private SuitSystem suit;
+    [SerializeField] private DialogueUI dialogueUI;
+
+    [SerializeField, Min(0f)] private float reinteractCooldown = 0.3f;
+
+    private float nextInteractTime;
+
+    public string InteractionPrompt =>
+        (suit != null && suit.IsEquipped) ? "Isi oksigen suit" : "Kenakan suit";
+
+    private void Start()
+    {
+        if (suit == null) suit = FindFirstObjectByType<SuitSystem>();
+        if (dialogueUI == null) dialogueUI = FindFirstObjectByType<DialogueUI>();
+
+        if (suit == null)
+            Debug.LogError("SuitStation: SuitSystem tidak ditemukan. Jalankan menu Mars > Setup Suit and Gate.", this);
+    }
+
+    public bool CanInteract(GameObject interactor)
+    {
+        if (suit == null || Time.time < nextInteractTime) return false;
+        return dialogueUI == null || !dialogueUI.IsOpen;
+    }
+
+    public void Interact(GameObject interactor)
+    {
+        if (suit == null) return;
+
+        ResourceManager resources = ResourceManager.Instance;
+        if (resources == null)
+        {
+            Debug.LogError("SuitStation: ResourceManager tidak ada di scene.", this);
+            return;
+        }
+
+        bool justEquipped = !suit.IsEquipped;
+        suit.Equip();
+        float added = suit.RefillFromHabitat();
+
+        float current = resources.Get(ResourceType.SuitOxygen);
+        float max = resources.GetMax(ResourceType.SuitOxygen);
+
+        string message = justEquipped ? "Suit dikenakan. " : "";
+
+        if (added > 0f)
+            message += "Oksigen suit terisi " + Mathf.RoundToInt(added) + " unit.";
+        else if (current >= max - 0.001f)
+            message += "Tabung oksigen suit sudah penuh.";
+        else
+            message += "Oksigen habitat tidak cukup untuk mengisi suit.";
+
+        message += " Oksigen suit: " + Mathf.RoundToInt(current) + " / " + Mathf.RoundToInt(max) + ".";
+
+        if (!suit.CanExit)
+            message += " Belum cukup untuk keluar (minimum " + Mathf.CeilToInt(suit.MinimumOxygenToExit) + ").";
+
+        ShowMessage(message);
+    }
+
+    private void ShowMessage(string message)
+    {
+        if (dialogueUI == null)
+        {
+            Debug.Log("SuitStation: " + message);
+            nextInteractTime = Time.time + reinteractCooldown;
+            return;
+        }
+
+        dialogueUI.Show("Suit Station", new[] { message }, () => nextInteractTime = Time.time + reinteractCooldown);
+    }
+}
diff --git a/Assets/Script/Suit/SuitSystem.cs b/Assets/Script/Suit/SuitSystem.cs
new file mode 100644
index 00000000..a7b848f8
--- /dev/null
+++ b/Assets/Script/Suit/SuitSystem.cs
@@ -0,0 +1,151 @@
+using System;
+using UnityEngine;
+
+/// <summary>
+/// Status Astronaut Suit: sudah dikenakan atau belum, pengisian dari oksigen habitat, dan
+/// pengurangan oksigen suit saat pemain berada di luar habitat.
+/// Angka oksigen suit disimpan di ResourceManager (ResourceType.SuitOxygen), terpisah dari HabitatOxygen.
+/// Hanya logika; tampilan ada di HudUI, interaksi ada di SuitStation, pembatas pintu ada di SuitGate.
+/// Pemain dianggap "di luar" bila tidak berada di dalam IndoorZone mana pun.
+/// Game Over karena oksigen habis belum dibuat; yang ada baru event OnSuitOxygenEmpty.
+/// </summary>
+public class SuitSystem : MonoBehaviour
+{
+    public static SuitSystem Instance { get; private set; }
+
+    [Header("Aturan suit (USULAN, ubah lewat Inspector setelah playtest)")]
+    [Tooltip("Oksigen suit minimum agar pemain boleh melewati gerbang keluar.")]
+    [SerializeField, Min(0f)] private float minimumOxygenToExit = 20f;
+    [Tooltip("Oksigen suit yang berkurang per detik selama pemain di luar habitat.")]
+    [SerializeField, Min(0f)] private float outdoorDrainPerSecond = 1f;
+
+    private ResourceManager resources;
+    private int indoorZoneCount;
+    private bool emptyReported;
+
+    /// <summary>True setelah pemain mengenakan suit di Suit Station.</summary>
+    public bool IsEquipped { get; private set; }
+
+    /// <summary>True bila pemain tidak berada di dalam IndoorZone mana pun. Awalnya dianggap di dalam habitat.</summary>
+    public bool IsOutdoors { get; private set; }
+
+    public float MinimumOxygenToExit => minimumOxygenToExit;
+
+    /// <summary>Suit dikenakan dan oksigennya cukup untuk keluar.</summary>
+    public bool CanExit =>
+        IsEquipped && resources != null && resources.Get(ResourceType.SuitOxygen) >= minimumOxygenToExit;
+
+    /// <summary>Dipanggil saat suit dikenakan (parameter: status terbaru).</summary>
+    public event Action<bool> OnEquippedChanged;
+
+    /// <summary>Dipanggil saat pemain keluar/masuk habitat (parameter: true bila di luar).</summary>
+    public event Action<bool> OnOutdoorChanged;
+
+    /// <summary>Dipanggil sekali ketika oksigen suit habis saat pemain di luar.</summary>
+    public event Action OnSuitOxygenEmpty;
+
+    private void Awake()
+    {
+        if (Instance != null && Instance != this)
+        {
+            Debug.LogWarning("SuitSystem: sudah ada instance lain, objek ini dihapus.", this);
+            Destroy(this);
+            return;
+        }
+
+        Instance = this;
+    }
+
+    private void Start()
+    {
+        resources = ResourceManager.Instance;
+        if (resources == null)
+            Debug.LogError("SuitSystem: ResourceManager tidak ada di scene.", this);
+
+        if (FindFirstObjectByType<IndoorZone>() == null)
+            Debug.LogWarning("SuitSystem: tidak ada IndoorZone di scene; oksigen suit tidak akan berkurang. Jalankan menu Mars > Setup Suit and Gate.", this);
+    }
+
+    private void OnDestroy()
+    {
+        if (Instance == this) Instance = null;
+    }
+
+    private void Update()
+    {
+        if (resources == null || !IsEquipped || !IsOutdoors) return;
+
+        // Ikut berhenti saat dialog terbuka atau transisi tidur, sama seperti timer hari.
+        TimeManager time = TimeManager.Instance;
+        if (time != null && time.IsPaused) return;
+
+        float current = resources.Get(ResourceType.SuitOxygen);
+        if (current > 0f)
+        {
+            float amount = Mathf.Min(outdoorDrainPerSecond * Time.deltaTime, current);
+            resources.TryConsume(ResourceType.SuitOxygen, amount);
+        }
+
+        if (resources.Get(ResourceType.SuitOxygen) <= 0f) ReportEmptyOnce();
+    }
+
+    /// <summary>Mengenakan suit. Tidak melakukan apa pun bila sudah dikenakan.</summary>
+    public void Equip()
+    {
+        if (IsEquipped) return;
+
+        IsEquipped = true;
+        OnEquippedChanged?.Invoke(true);
+    }
+
+    /// <summary>
+    /// Memindahkan oksigen dari stok habitat ke tabung suit sampai penuh atau stok habitat habis.
+    /// Mengembalikan jumlah yang benar-benar masuk ke suit.
+    /// </summary>
+    public float RefillFromHabitat()
+    {
+        if (resources == null) return 0f;
+
+        float missing = resources.GetMax(ResourceType.SuitOxygen) - resources.Get(ResourceType.SuitOxygen);
+        float available = resources.Get(ResourceType.HabitatOxygen);
+        float amount = Mathf.Min(missing, available);
+        if (amount <= 0f) return 0f;
+
+        if (!resources.TryConsume(ResourceType.HabitatOxygen, amount)) return 0f;
+
+        float added = resources.Add(ResourceType.SuitOxygen, amount);
+        if (added > 0f) emptyReported = false;
+        return added;
+    }
+
+    /// <summary>Dipanggil IndoorZone saat pemain masuk ke sebuah zona dalam habitat.</summary>
+    public void NotifyEnteredIndoor()
+    {
+        indoorZoneCount++;
+        SetOutdoors(false);
+    }
+
+    /// <summary>Dipanggil IndoorZone saat pemain keluar dari sebuah zona dalam habitat.</summary>
+    public void NotifyExitedIndoor()
+    {
+        indoorZoneCount = Mathf.Max(0, indoorZoneCount - 1);
+        if (indoorZoneCount == 0) SetOutdoors(true);
+    }
+
+    private void SetOutdoors(bool outdoors)
+    {
+        if (IsOutdoors == outdoors) return;
+
+        IsOutdoors = outdoors;
+        OnOutdoorChanged?.Invoke(outdoors);
+    }
+
+    private void ReportEmptyOnce()
+    {
+        if (emptyReported) return;
+
+        emptyReported = true;
+        Debug.LogWarning("SuitSystem: oksigen suit habis saat di luar. (Game Over/countdown darurat belum dibuat.)");
+        OnSuitOxygenEmpty?.Invoke();
+    }
+}
