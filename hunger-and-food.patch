new file mode 100644
index 00000000..c51ac470
--- /dev/null
+++ b/Assets/Script/Survival/HungerReminder.cs
@@ -0,0 +1,91 @@
+using UnityEngine;
+
+/// <summary>
+/// Pengingat TARS soal lapar (GDD 6.3: peringatan harus muncul sebelum game over). Dialog dengan teks tetap
+/// (tanpa AI generatif) saat kenyang turun melewati batas peringatan, batas bahaya, dan saat kelaparan (0).
+/// Setiap batas hanya diumumkan sekali per penurunan; setelah pemain makan dan kenyang naik di atas batas itu,
+/// batas tersebut bisa diumumkan lagi. Bila dialog lain sedang terbuka, pesan menunggu sampai dialog tertutup.
+/// Sementara pengganti TARSSystem: saat TARSSystem dibuat, logika ini boleh dipindahkan ke sana.
+/// </summary>
+public class HungerReminder : MonoBehaviour
+{
+    [Header("Referensi (otomatis dicari jika kosong)")]
+    [SerializeField] private HungerSystem hunger;
+    [SerializeField] private DialogueUI dialogueUI;
+
+    private int announcedLevel;
+    private int pendingLevel;
+
+    private void Start()
+    {
+        if (hunger == null) hunger = FindFirstObjectByType<HungerSystem>();
+        if (dialogueUI == null) dialogueUI = FindFirstObjectByType<DialogueUI>();
+
+        if (hunger == null)
+        {
+            Debug.LogError("HungerReminder: HungerSystem tidak ditemukan. Jalankan menu Mars > Setup Hunger and Food Storage.", this);
+            enabled = false;
+            return;
+        }
+
+        hunger.OnSatietyChanged += HandleSatietyChanged;
+    }
+
+    private void OnDestroy()
+    {
+        if (hunger != null) hunger.OnSatietyChanged -= HandleSatietyChanged;
+    }
+
+    private void HandleSatietyChanged(float satiety, float max)
+    {
+        int level = GetLevel();
+
+        if (level < announcedLevel) announcedLevel = level; // pemain sudah makan; batas boleh diumumkan lagi
+        pendingLevel = level > announcedLevel ? level : 0;
+    }
+
+    private void Update()
+    {
+        if (pendingLevel <= announcedLevel) return;
+        if (dialogueUI != null && dialogueUI.IsOpen) return;
+
+        announcedLevel = pendingLevel;
+        pendingLevel = 0;
+        Show(BuildLine(announcedLevel));
+    }
+
+    /// <summary>0 = aman, 1 = peringatan, 2 = bahaya, 3 = kelaparan.</summary>
+    private int GetLevel()
+    {
+        if (hunger.IsStarving) return 3;
+        float fraction = hunger.Fraction;
+        if (fraction <= hunger.DangerFraction) return 2;
+        if (fraction <= hunger.WarnFraction) return 1;
+        return 0;
+    }
+
+    private string BuildLine(int level)
+    {
+        switch (level)
+        {
+            case 1:
+                return "Anda mulai lapar. Makan di tempat makan di Control Room sebelum kondisi Anda memburuk.";
+            case 2:
+                return "Peringatan. Anda sangat lapar. Saya menyarankan segera makan.";
+            default:
+                return "Anda kelaparan. Waktu tersisa untuk makan: sekitar " +
+                       Mathf.CeilToInt(hunger.StarvationSecondsLeft) + " detik.";
+        }
+    }
+
+    private void Show(string line)
+    {
+        if (dialogueUI == null)
+        {
+            Debug.Log("TARS: " + line);
+            return;
+        }
+
+        dialogueUI.Show("TARS", new[] { line }, null);
+    }
+}
diff --git a/Assets/Script/Survival/HungerSystem.cs b/Assets/Script/Survival/HungerSystem.cs
new file mode 100644
index 00000000..81a37a6a
--- /dev/null
+++ b/Assets/Script/Survival/HungerSystem.cs
@@ -0,0 +1,140 @@
+using System;
+using UnityEngine;
+
+/// <summary>
+/// Rasa kenyang pemain (hunger). Nilai 0 sampai MaxSatiety: 100 = kenyang, 0 = kelaparan.
+/// Kenyang berkurang pelan selama waktu gameplay berjalan (ikut jeda TimeManager.IsPaused, jadi berhenti saat
+/// transisi tidur). Pemain makan di FoodStorage: Food (stok habitat, ResourceManager) dikurangi dan kenyang bertambah.
+/// Stok Food tidak berkurang sendiri; Food hanya berkurang saat pemain makan.
+/// Bila kenyang 0, hitung mundur kelaparan (starvationGraceSeconds) berjalan; makan sebelum habis membatalkannya.
+/// Game Over belum dibuat; yang ada baru event OnStarvationFailure (hanya log), seperti SuitSystem.OnSuitOxygenEmpty.
+/// Hanya logika; tampilan ada di HudUI, interaksi di FoodStorage, pengingat di HungerReminder.
+/// </summary>
+public class HungerSystem : MonoBehaviour
+{
+    public static HungerSystem Instance { get; private set; }
+
+    [Header("Kenyang (USULAN, ubah lewat Inspector setelah playtest)")]
+    [SerializeField, Min(1f)] private float maxSatiety = 100f;
+    [SerializeField, Min(0f)] private float startSatiety = 100f;
+    [Tooltip("Kenyang yang berkurang per detik gameplay. 0,08 = penuh habis sekitar 21 menit (sekitar 2 hari game).")]
+    [SerializeField, Min(0f)] private float drainPerSecond = 0.08f;
+
+    [Header("Makan (USULAN)")]
+    [Tooltip("Food yang dipakai untuk satu porsi penuh.")]
+    [SerializeField, Min(0.1f)] private float foodPerMeal = 10f;
+    [Tooltip("Kenyang yang didapat dari satu porsi penuh.")]
+    [SerializeField, Min(0.1f)] private float satietyPerMeal = 25f;
+
+    [Header("Peringatan dan kelaparan (USULAN)")]
+    [SerializeField, Range(0f, 1f)] private float warnFraction = 0.3f;
+    [SerializeField, Range(0f, 1f)] private float dangerFraction = 0.1f;
+    [Tooltip("Detik yang tersedia untuk makan sejak kenyang 0 sebelum kondisi gagal.")]
+    [SerializeField, Min(1f)] private float starvationGraceSeconds = 60f;
+
+    private ResourceManager resources;
+    private float starvationTimer;
+    private bool failureReported;
+
+    public float Satiety { get; private set; }
+    public float MaxSatiety => maxSatiety;
+    public float Fraction => maxSatiety > 0f ? Satiety / maxSatiety : 0f;
+    public float WarnFraction => warnFraction;
+    public float DangerFraction => dangerFraction;
+    public float StarvationGraceSeconds => starvationGraceSeconds;
+    public bool IsStarving => Satiety <= 0f;
+    public float StarvationSecondsLeft => Mathf.Max(0f, starvationGraceSeconds - starvationTimer);
+
+    /// <summary>True bila pemain belum kenyang penuh dan stok Food masih ada.</summary>
+    public bool CanEat =>
+        resources != null && Satiety < maxSatiety - 0.5f && resources.Get(ResourceType.Food) > 0f;
+
+    /// <summary>Dipanggil setiap kenyang berubah: (nilai baru, maksimum).</summary>
+    public event Action<float, float> OnSatietyChanged;
+
+    /// <summary>Dipanggil sekali ketika hitung mundur kelaparan habis (Game Over belum dibuat).</summary>
+    public event Action OnStarvationFailure;
+
+    private void Awake()
+    {
+        if (Instance != null && Instance != this)
+        {
+            Debug.LogWarning("HungerSystem: sudah ada instance lain, objek ini dihapus.", this);
+            Destroy(this);
+            return;
+        }
+
+        Instance = this;
+        Satiety = Mathf.Clamp(startSatiety, 0f, maxSatiety);
+    }
+
+    private void Start()
+    {
+        resources = ResourceManager.Instance;
+        if (resources == null)
+            Debug.LogError("HungerSystem: ResourceManager tidak ada di scene.", this);
+    }
+
+    private void OnDestroy()
+    {
+        if (Instance == this) Instance = null;
+    }
+
+    private void Update()
+    {
+        TimeManager time = TimeManager.Instance;
+        if (time != null && time.IsPaused) return;
+
+        if (Satiety > 0f)
+        {
+            float next = Mathf.Max(0f, Satiety - drainPerSecond * Time.deltaTime);
+            if (!Mathf.Approximately(next, Satiety))
+            {
+                Satiety = next;
+                OnSatietyChanged?.Invoke(Satiety, maxSatiety);
+            }
+        }
+
+        if (Satiety > 0f) return;
+
+        starvationTimer += Time.deltaTime;
+        if (starvationTimer >= starvationGraceSeconds && !failureReported)
+        {
+            failureReported = true;
+            Debug.LogWarning("HungerSystem: kelaparan melewati batas. (Game Over belum dibuat.)");
+            OnStarvationFailure?.Invoke();
+        }
+    }
+
+    /// <summary>
+    /// Makan satu porsi dari stok Food. Hanya memakai Food sebanyak yang dibutuhkan (tidak ada yang terbuang
+    /// bila hampir kenyang) dan sebanyak yang tersedia (porsi kecil bila stok hampir habis).
+    /// Mengembalikan false bila tidak bisa makan (stok kosong atau sudah kenyang).
+    /// </summary>
+    public bool Eat(out float foodUsed, out float satietyGained)
+    {
+        foodUsed = 0f;
+        satietyGained = 0f;
+        if (!CanEat) return false;
+
+        float satietyPerFood = satietyPerMeal / foodPerMeal;
+        float needed = (maxSatiety - Satiety) / satietyPerFood;
+        float amount = Mathf.Min(foodPerMeal, Mathf.Min(resources.Get(ResourceType.Food), needed));
+        if (amount <= 0f || !resources.TryConsume(ResourceType.Food, amount)) return false;
+
+        foodUsed = amount;
+        satietyGained = Mathf.Min(amount * satietyPerFood, maxSatiety - Satiety);
+        Satiety += satietyGained;
+        starvationTimer = 0f;
+        failureReported = false;
+        OnSatietyChanged?.Invoke(Satiety, maxSatiety);
+        return true;
+    }
+
+    [ContextMenu("Debug: Kenyang jadi 0")]
+    private void DebugSetEmpty()
+    {
+        Satiety = 0f;
+        OnSatietyChanged?.Invoke(Satiety, maxSatiety);
+    }
+}
