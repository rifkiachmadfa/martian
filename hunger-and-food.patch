@@ -0,0 +1,80 @@
+using UnityEngine;
+
+/// <summary>
+/// Tempat makan di Control Room (tombol E: "Makan"). Memanggil HungerSystem.Eat: Food stok habitat
+/// berkurang dan kenyang pemain bertambah. Tidak memberi tugas; hanya melayani kebutuhan makan pemain.
+/// Pasang pada objek ber-layer Interactable dengan Collider2D (Is Trigger).
+/// </summary>
+public class FoodStorage : MonoBehaviour, IInteractable
+{
+    [Header("Referensi (otomatis dicari jika kosong)")]
+    [SerializeField] private HungerSystem hunger;
+    [SerializeField] private DialogueUI dialogueUI;
+
+    [SerializeField, Min(0f)] private float reinteractCooldown = 0.3f;
+
+    private float nextInteractTime;
+
+    public string InteractionPrompt => "Makan";
+
+    private void Start()
+    {
+        if (hunger == null) hunger = FindFirstObjectByType<HungerSystem>();
+        if (dialogueUI == null) dialogueUI = FindFirstObjectByType<DialogueUI>();
+
+        if (hunger == null)
+            Debug.LogError("FoodStorage: HungerSystem tidak ditemukan. Jalankan menu Mars > Setup Hunger and Food Storage.", this);
+    }
+
+    public bool CanInteract(GameObject interactor)
+    {
+        if (hunger == null || Time.time < nextInteractTime) return false;
+        return dialogueUI == null || !dialogueUI.IsOpen;
+    }
+
+    public void Interact(GameObject interactor)
+    {
+        if (hunger == null) return;
+
+        ResourceManager resources = ResourceManager.Instance;
+        if (resources == null)
+        {
+            Debug.LogError("FoodStorage: ResourceManager tidak ada di scene.", this);
+            return;
+        }
+
+        string status = " Kenyang: " + Mathf.RoundToInt(hunger.Satiety) + " / " + Mathf.RoundToInt(hunger.MaxSatiety) +
+                        ". Food: " + Mathf.RoundToInt(resources.Get(ResourceType.Food)) + " / " +
+                        Mathf.RoundToInt(resources.GetMax(ResourceType.Food)) + ".";
+
+        if (hunger.Satiety >= hunger.MaxSatiety - 0.5f)
+        {
+            ShowMessage("Anda belum lapar." + status);
+            return;
+        }
+
+        if (!hunger.Eat(out float foodUsed, out float satietyGained))
+        {
+            ShowMessage("Stok Food habis." + status);
+            return;
+        }
+
+        ShowMessage("Anda makan. Food berkurang " + Mathf.RoundToInt(foodUsed) + ", kenyang bertambah " +
+                    Mathf.RoundToInt(satietyGained) + "." +
+                    " Kenyang: " + Mathf.RoundToInt(hunger.Satiety) + " / " + Mathf.RoundToInt(hunger.MaxSatiety) +
+                    ". Food: " + Mathf.RoundToInt(resources.Get(ResourceType.Food)) + " / " +
+                    Mathf.RoundToInt(resources.GetMax(ResourceType.Food)) + ".");
+    }
+
+    private void ShowMessage(string message)
+    {
+        if (dialogueUI == null)
+        {
+            Debug.Log("FoodStorage: " + message);
+            nextInteractTime = Time.time + reinteractCooldown;
+            return;
+        }
+
+        dialogueUI.Show("Tempat Makan", new[] { message }, () => nextInteractTime = Time.time + reinteractCooldown);
+    }
+}
